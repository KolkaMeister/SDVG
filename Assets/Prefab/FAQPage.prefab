  m_text: "       \u041D\u0430 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0435 \u0441
    \u0437\u0430\u0434\u0430\u0447\u0430\u043C\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0435 \u043F\u043E\u043B\u0435.
    \u041F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F
    \u043D\u043E\u0432\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430
    \u201C\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u0437\u0430\u0434\u0430\u0447\u0443\u201D,
    \u0433\u0434\u0435 \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0443\u043A\u0430\u0437\u0430\u0442\u044C
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435, \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442
    \u0438 \u0432\u0440\u0435\u043C\u044F. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
    \u201C\u0413\u043E\u0442\u043E\u0432\u043E\u201D \u0432\u043D\u0438\u0437\u0443
    \u044D\u043A\u0440\u0430\u043D\u0430, \u0438 \u0437\u0430\u0434\u0430\u0447\u0430
    \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u043D\u0430."
